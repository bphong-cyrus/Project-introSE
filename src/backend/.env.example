# SmartSpend AI - Backend env
# Copy to .env and fill in real values.

# Google AI Studio Gemini API key(s).
# Get free keys (no credit card) at https://aistudio.google.com/apikey
# Free tier per key: 15 RPM, 1500 RPD, vision requests included.
#
# Option A (recommended): comma-separated list. The server pools them
# in round-robin and falls over to the next key automatically when one
# hits RESOURCE_EXHAUSTED (429). With 4 keys you get ~60 RPM aggregate.
GEMINI_API_KEYS=PASTE-KEY-1,PASTE-KEY-2,PASTE-KEY-3,PASTE-KEY-4

# Option B: numbered variants (same effect, more readable in .env).
# GOOGLE_API_KEY_1=...
# GOOGLE_API_KEY_2=...
# GOOGLE_API_KEY_3=...
# GOOGLE_API_KEY_4=...

# Option C (legacy): single key. Still works, but no failover.
# GOOGLE_API_KEY=PASTE-KEY-1

# Gemini vision model. Must support image input.
# Verified against the live demo keys on 2026-08-30.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Retry low-confidence scans once with the stronger model. The complete two-pass
# flow shares an 8-second budget; a failed fallback preserves the Lite result.
AI_LOW_CONFIDENCE_RETRY=true
AI_LOW_CONFIDENCE_RETRY_THRESHOLD=80
AI_RETRY_TOTAL_BUDGET_MS=8000

# Cooldown (ms) before the pool retries a key that hit a quota error.
# 60s is enough because the Gemini free-tier RPM window resets every minute.
GEMINI_KEY_COOLDOWN_MS=60000
# Hard stop for one Gemini call so third-party latency cannot hang the backend.
GEMINI_REQUEST_TIMEOUT_MS=15000

# Express server port
PORT=4000

# Allowed origins for CORS (Expo dev default + LAN IP for physical device)
# Add your local IP if testing on a real device, e.g. http://192.168.1.42:8081
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# Max upload size in bytes (4 MB is plenty for a receipt photo)
MAX_UPLOAD_BYTES=4194304

# Optional Supabase override for the Report & Export Controller.
# If these are omitted, backend reads the same values from
# ../data/datasources/supabase/supabase.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=PASTE-SUPABASE-ANON-KEY

# Optional. Used when inserting into report_exports.export_type.
# Defaults to "excel". Override this if your live DB check constraint only
# allows another value.
REPORT_EXPORT_TYPE=excel

# Optional. Used when inserting into report_exports.status.
# Defaults to "success". Override this if your live DB check constraint only
# allows another value such as completed/pending/ready.
REPORT_EXPORT_STATUS=success
