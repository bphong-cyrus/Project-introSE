# SmartSpend AI - Backend env
# Copy to .env and fill in real values.

# Google AI Studio Gemini API key(s).
# Get free keys (no credit card) at https://aistudio.google.com/apikey
# Free tier per key: 15 RPM, 1500 RPD, vision requests included.
#
# Option A (recommended): comma-separated list. The server pools them
# in round-robin and falls over to the next key automatically when one
# hits RESOURCE_EXHAUSTED (429). With 4 keys you get ~60 RPM aggregate.
GEMINI_API_KEYS=PASTE-KEY-1,PASTE-KEY-2,PASTE-KEY-3,PASTE-KEY-4

# Option B: numbered variants (same effect, more readable in .env).
# GOOGLE_API_KEY_1=...
# GOOGLE_API_KEY_2=...
# GOOGLE_API_KEY_3=...
# GOOGLE_API_KEY_4=...

# Option C (legacy): single key. Still works, but no failover.
# GOOGLE_API_KEY=PASTE-KEY-1

# Gemini vision model. Must support image input.
# - gemini-2.0-flash    : fast, free tier friendly (default)
# - gemini-1.5-flash    : previous gen, also vision-capable
# - gemini-1.5-pro      : higher accuracy, slower, lower free quota
GEMINI_MODEL=gemini-2.0-flash

# Cooldown (ms) before the pool retries a key that hit a quota error.
# 60s is enough because the Gemini free-tier RPM window resets every minute.
GEMINI_KEY_COOLDOWN_MS=60000

# Express server port
PORT=4000

# Allowed origins for CORS (Expo dev default + LAN IP for physical device)
# Add your local IP if testing on a real device, e.g. http://192.168.1.42:8081
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# Max upload size in bytes (4 MB is plenty for a receipt photo)
MAX_UPLOAD_BYTES=4194304