# SmartSpend AI - Mobile app env (Expo reads this at build time)
# Copy to .env and fill in real values. After changing, restart with:
#   npx expo start -c

# Backend URL the mobile app talks to.
# Default (http://10.0.2.2:4000) works for Android emulator → host machine.
# For physical device on LAN, set to http://<your-LAN-ip>:4000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# The Gemini API key lives on the SERVER, not in the mobile bundle.
# Paste the server-side key list into src/backend/.env instead
# (variable name GEMINI_API_KEYS; never put keys in this mobile file).
# EXPO_PUBLIC_GOOGLE_API_KEY is intentionally NOT set here — that would ship
# the credential inside the JS bundle, which is a security risk.
