{
  "expo": {
    "name": "SmartSpend AI",
    "slug": "SmartSpendAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "sdkVersion": "54.0.0",
    "splash": {
      "image": "./img/smartspend-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#4CAF50"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartspendai.app"
    },
    "android": {
      "package": "com.smartspendai.app"
    },
    "web": {
      "favicon": "./img/smartspend-logo.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SmartSpend AI cần quyền truy cập thư viện ảnh để bạn cập nhật avatar và chọn ảnh hóa đơn.",
          "cameraPermission": "SmartSpend AI cần quyền camera để quét hóa đơn."
        }
      ]
    ]
  }
}
